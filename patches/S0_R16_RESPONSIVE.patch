+/* S0 — correction du rendu des grands tableaux MathJax, sans modifier les gabarits. */
+.correction-facteur { width:100%; max-width:100%; min-width:0; box-sizing:border-box; overflow:hidden; }
+.correction-facteur .math-viewport { width:100%; max-width:100%; min-width:0; overflow-x:auto; overflow-y:hidden; overscroll-behavior-x:contain; -webkit-overflow-scrolling:touch; scrollbar-width:auto; scrollbar-color:#64748b #e7eaf0; margin:0 0 4px; padding:3px 0 9px; }
+.correction-facteur .math-viewport::-webkit-scrollbar { height:9px; }
+.correction-facteur .math-viewport::-webkit-scrollbar-thumb { background:#64748b; border-radius:8px; }
+.correction-facteur .math-viewport::-webkit-scrollbar-track { background:#e7eaf0; border-radius:8px; }
+.correction-facteur .math-viewport .math-inner { display:table; width:max-content; max-width:none; margin-left:auto; margin-right:auto; }
+.correction-facteur .math-viewport mjx-container { overflow:visible!important; max-width:none!important; white-space:nowrap; text-align:initial; padding:0; margin:0; }
+.correction-facteur .math-viewport[data-overflow="true"] .math-inner { margin-left:0; margin-right:0; }
+.math-deplacement { display:flex; align-items:center; justify-content:space-between; gap:8px; padding:5px 2px 10px; color:#43516d; font-size:.8rem; }
+.math-deplacement[hidden] { display:none!important; }
+.math-deplacement button { border:1px solid #bcc6d6; border-radius:7px; padding:4px 12px; background:#fffdf8; color:#16223e; font-weight:700; cursor:pointer; }
+.math-deplacement button:disabled { opacity:.45; cursor:default; }
