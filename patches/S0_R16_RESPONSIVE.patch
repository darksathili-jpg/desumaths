+// Une adaptation du conteneur uniquement. Le texte et le LaTeX historiques ne changent pas.
+function preparerTableauxMathJax(element) {
+  if (!element || element.id !== 'correctiond') return;
+  const tableaux = Array.from(element.querySelectorAll('mjx-container'));
+  for (const tableau of tableaux) {
+    if (tableau.closest('.math-viewport')) continue;
+    const zone = document.createElement('div');
+    zone.className = 'math-viewport';
+    zone.setAttribute('tabindex', '0');
+    zone.setAttribute('role', 'region');
+    zone.setAttribute('aria-label', 'Tableau de correction mathématique, défilement horizontal si nécessaire');
+    const interieur = document.createElement('div');
+    interieur.className = 'math-inner';
+    tableau.parentNode.insertBefore(zone, tableau);
+    zone.appendChild(interieur);
+    interieur.appendChild(tableau);
+    const commandes = document.createElement('div');
+    commandes.className = 'math-deplacement';
+    commandes.hidden = true;
+    const gauche = document.createElement('button');
+    gauche.type = 'button'; gauche.textContent = '←'; gauche.setAttribute('aria-label', 'Voir le début du tableau');
+    const notice = document.createElement('span');
+    notice.textContent = 'Faire glisser pour lire la suite';
+    const droite = document.createElement('button');
+    droite.type = 'button'; droite.textContent = '→'; droite.setAttribute('aria-label', 'Voir la suite du tableau');
+    commandes.append(gauche, notice, droite);
+    zone.insertAdjacentElement('afterend', commandes);
+    const actualiser = () => {
+      const surplus = zone.scrollWidth - zone.clientWidth;
+      const depasse = surplus > 3;
+      zone.dataset.overflow = String(depasse);
+      commandes.hidden = !depasse;
+      gauche.disabled = zone.scrollLeft <= 2;
+      droite.disabled = zone.scrollLeft >= surplus - 2;
+    };
+    gauche.addEventListener('click', () => zone.scrollBy({left:-Math.max(160, zone.clientWidth*.7),behavior:'smooth'}));
+    droite.addEventListener('click', () => zone.scrollBy({left:Math.max(160, zone.clientWidth*.7),behavior:'smooth'}));
+    zone.addEventListener('scroll',actualiser,{passive:true});
+    if (typeof ResizeObserver !== 'undefined') {
+      const observer = new ResizeObserver(actualiser);
+      observer.observe(zone); observer.observe(interieur);
+    }
+    requestAnimationFrame(actualiser);
+  }
+}
